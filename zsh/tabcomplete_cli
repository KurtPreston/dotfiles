# Zsh tab completion for CLIs that generate their own (`<cmd> completion zsh`)
# Docker Desktop installs docker and kubectl in ~/.docker/bin (see shared/env)

if (( $+functions[compdef] )); then
    for _cli in docker kubectl; do
        if (( $+commands[$_cli] )); then
            eval "$("$_cli" completion zsh 2>/dev/null)"
        fi
    done
    unset _cli
fi
