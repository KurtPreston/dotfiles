# Zsh configuration file
# This file is sourced by zsh

# Source zsh-specific aliases
source ~/.dotfiles/zsh/aliases

# Source prompt configuration
source ~/.dotfiles/zsh/prompt

# Source shared environment variables first
source ~/.dotfiles/shared/env

# Source other shared files
for file in ~/.dotfiles/shared/*; do
    if [[ "$file" != ~/.dotfiles/shared/env && "$file" != ~/.dotfiles/shared/agentbox && "$file" != ~/.dotfiles/shared/direnv ]]; then
        source "$file"
    fi
done

# Source local configuration if it exists
if [[ -f ~/.localrc ]]; then
    source ~/.localrc
fi

# Put the agentbox shims first on PATH, after every version manager above
source ~/.dotfiles/shared/agentbox

# Initialize completion. Each zsh/completions/_<command> file is a #compdef
# function that compinit autoloads on the command's first Tab.
fpath=(~/.dotfiles/zsh/completions $fpath)
autoload -Uz compinit
compinit

# Source keybindings
source ~/.dotfiles/zsh/keybindings

# Source history configuration (after fzf/keybindings so the Ctrl+R override wins)
source ~/.dotfiles/zsh/history

# Zsh-specific configuration can be added here

# Load the direnv hook last, after everything that touches the prompt
source ~/.dotfiles/shared/direnv
