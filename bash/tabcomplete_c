# Bash tab completion functions

# Completion function for 'c' alias
_c_completion() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local code_home="${CODE_HOME:-$HOME/Code}"
    COMPREPLY=()

    # Only provide completions if CODE_HOME directory exists
    [[ -d "$code_home" ]] || return

    # Match directories (including nested paths) relative to CODE_HOME,
    # skipping hidden ones unless the typed segment starts with a dot
    local dir
    while IFS= read -r dir; do
        [[ "${dir##*/}" == .* && "${cur##*/}" != .* ]] && continue
        COMPREPLY+=("${dir#"$code_home"/}/")
    done < <(compgen -d -- "$code_home/$cur")

    # Keep the cursor after the trailing slash so subdirectories can follow
    compopt -o nospace 2>/dev/null
}

# Register completion for the 'c' alias
complete -F _c_completion c
