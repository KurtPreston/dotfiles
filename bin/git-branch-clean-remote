#!/usr/bin/env bash

# Git Branch Clean Remote
# Clears out remote branches already present on the remote default branch,
# including squash- and rebase-merged work (not just ancestry merges).

set -euo pipefail

# Progress helpers: only draw an in-place status line when stderr is a terminal,
# so piped/logged runs stay clean.
progress() {
  [[ -t 2 ]] && printf '\r\033[K  [%d/%d] %s' "$1" "$2" "$3" >&2
  return 0
}
clear_progress() {
  [[ -t 2 ]] && printf '\r\033[K' >&2
  return 0
}

echo "Fetching latest refs from origin (git fetch --prune)..."
git fetch --prune

echo "Resolving remote default branch..."
default_branch="$(git-default-branch)"
into="origin/${default_branch}"
echo "Comparing remote branches against ${into}"

is_protected() {
  local branch="$1"
  [[ "$branch" == "$default_branch" || "$branch" == "master" || "$branch" == "main" || "$branch" == "staging" ]] && return 0
  [[ "$branch" == release* ]] && return 0
  return 1
}

# Squash/rebase detection relies on `git cherry` (patch-ids), which reads blob
# content. On a blobless partial clone that lazy-fetches from the remote, and
# this script checks every remote branch (potentially hundreds), so we fall back
# to ancestry-only detection there to avoid a fetch stampede.
is_partial_clone() {
  [[ "$(git config --get remote.origin.promisor 2>/dev/null)" == "true" ]] && return 0
  [[ -n "$(git config --get remote.origin.partialclonefilter 2>/dev/null)" ]] && return 0
  return 1
}

detect_squash=1
if is_partial_clone; then
  echo "Partial (blobless) clone detected; skipping squash/rebase-merge detection (ancestry-only)." >&2
  detect_squash=0
fi

to_delete=()

branches=()
while IFS= read -r branch; do
  [[ -z "$branch" || "$branch" == "HEAD" ]] && continue
  branches+=("$branch")
done < <(
  git branch -r --format='%(refname:short)' \
    | grep '^origin/' \
    | sed 's|^origin/||' \
    || true
)

total=${#branches[@]}
echo "Examining ${total} remote branch(es) for merged/squashed work..."

i=0
for branch in "${branches[@]}"; do
  i=$((i + 1))
  progress "$i" "$total" "$branch"
  is_protected "$branch" && continue

  ref="origin/${branch}"
  if git merge-base --is-ancestor "$ref" "$into" 2>/dev/null; then
    to_delete+=("$branch")
  elif [[ "$detect_squash" == 1 ]] && git-branch-squash-merged "$ref" "$into"; then
    to_delete+=("$branch")
  fi
done
clear_progress
echo "Found ${#to_delete[@]} remote branch(es) to delete."

if [[ ${#to_delete[@]} -eq 0 ]]; then
  echo "No remote branches to delete"
  exit 0
fi

git push --delete origin "${to_delete[@]}"
