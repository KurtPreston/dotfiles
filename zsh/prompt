# Text formatting params
autoload -U colors && colors

# Enable prompt substitution
setopt PROMPT_SUBST

# Names the commit a detached HEAD is sitting on: a local branch on that commit
# if there is one, otherwise a remote-tracking branch, origin first.
# refs/remotes/<remote>/HEAD points at the remote's default branch rather than
# being a branch itself, and sorts ahead of the real ones, so filter it out.
__git_branch_at_head() {
  local branch remotes

  branch=$(git for-each-ref --count=1 --format='%(refname:short)' --points-at HEAD refs/heads/ 2>/dev/null)
  if [[ -n "$branch" ]]; then
    printf '%s' "$branch"
    return 0
  fi

  remotes=$(git for-each-ref --format='%(refname:short)' --points-at HEAD refs/remotes/ 2>/dev/null | grep -v '/HEAD$')
  branch=$(printf '%s\n' "$remotes" | grep -m1 '^origin/')
  printf '%s' "${branch:-$(printf '%s\n' "$remotes" | head -n1)}"
}

# Branch name plus green/red for clean/dirty, where dirty means unstaged or
# conflicted changes to tracked files. Each git call costs a full process
# start, so a single `git status` supplies both.
# status must keep its default optional locking (no GIT_OPTIONAL_LOCKS=0): that
# is what lets it write the refreshed index back, so after a pull or build
# touches many files only one prompt pays to re-check them. `git diff` can't
# repair files written in the same second as the index, and re-reads them on
# every prompt until something else rewrites it.
git_prompt() {
  local out branch rc=0 color="%F{green}"

  if out=$(git status --porcelain=v2 --branch --untracked-files=no --no-ahead-behind 2>&1); then
    branch=${out#*'# branch.head '}
    branch=${branch%%$'\n'*}
    # Entries are "1 XY ..." / "2 XY ..." (Y is the unstaged state, '.' when
    # none) or "u ..." for conflicts; staged-only changes stay green.
    [[ $'\n'$out == *$'\n'[12]' '?[^.]* || $'\n'$out == *$'\n''u '* ]] && color="%F{red}"
    [[ "$branch" == "(detached)" ]] && rc=1
  else
    [[ "$out" == *"not a git repository"* ]] && return 0
    # No work tree (inside .git, or a bare repo), so status can't report
    # changes. Exit status 0 means on a branch, 1 a detached HEAD.
    branch=$(git symbolic-ref --short -q HEAD 2>/dev/null)
    rc=$?
    (( rc > 1 )) && return 0
    color="%F{red}"
  fi

  if (( rc == 1 )); then
    branch=$(__git_branch_at_head)
    branch="${branch:-$(git rev-parse --short HEAD 2>/dev/null)} (detached)"
  fi

  # Escape % so a branch name can't inject prompt sequences.
  echo "[$color${branch//\%/%%}%f] "
}

show_host_if_remote() {
  if [[ ! -z "$SSH_CONNECTION" ]]; then
    echo "%F{blue}$(hostname)%f"
  fi
}

# Prompt escapes rather than whoami, which would fork twice per prompt: %n is
# the user name and %(!.a.b) picks a when running with root privileges.
show_colored_user() {
  echo '%(!.%F{red}%n%f.%n)'
}

show_path() {
  echo "%F{cyan}%~%f"
}

# Set the prompt
PS1='$(git_prompt)$(show_colored_user)@$(show_host_if_remote)$(show_path): '