#compdef kubectl
# Zsh tab completion for kubectl, generated by kubectl itself
# Docker Desktop installs kubectl in ~/.docker/bin (see shared/env)

# The generated script redefines _kubectl; call it only if that worked
local stub="$functions[_kubectl]"
eval "$(kubectl completion zsh 2>/dev/null)"
[[ "$functions[_kubectl]" != "$stub" ]] && _kubectl "$@"
