#!/usr/bin/env bash

# Git Branch Clean Remote
# Clears out remote branches that have already been merged into the
# canonical remote default branch (origin/HEAD), not the current checkout.

set -euo pipefail

git fetch --prune

default_branch="$(git-default-branch)"

echo "Checkout successful -- Updating/cleaning code"

# Protected: remote default and common long-lived branches
branches_to_delete="$(
  git branch -r --merged "origin/${default_branch}" \
    | grep 'origin/' \
    | grep -v '->' \
    | sed 's|^[[:space:]]*origin/||' \
    | grep -v -x -F -e "$default_branch" -e master -e main -e staging \
    | grep -v '^release' \
    || true
)"

if [[ -z "$branches_to_delete" ]]; then
  echo "No remote branches to delete"
else
  # shellcheck disable=SC2086
  echo $branches_to_delete | xargs git push --delete origin
fi
