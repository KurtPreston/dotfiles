# Text formatting params
autoload -U colors && colors

# Enable prompt substitution
setopt PROMPT_SUBST

# Names the commit a detached HEAD is sitting on: a local branch on that commit
# if there is one, otherwise a remote-tracking branch, origin first.
# refs/remotes/<remote>/HEAD points at the remote's default branch rather than
# being a branch itself, and sorts ahead of the real ones, so filter it out.
__git_branch_at_head() {
  local branch remotes

  branch=$(git for-each-ref --count=1 --format='%(refname:short)' --points-at HEAD refs/heads/ 2>/dev/null)
  if [[ -n "$branch" ]]; then
    printf '%s' "$branch"
    return 0
  fi

  remotes=$(git for-each-ref --format='%(refname:short)' --points-at HEAD refs/remotes/ 2>/dev/null | grep -v '/HEAD$')
  branch=$(printf '%s\n' "$remotes" | grep -m1 '^origin/')
  printf '%s' "${branch:-$(printf '%s\n' "$remotes" | head -n1)}"
}

# Branch name, colored green when clean, red when tracked files have unstaged
# or conflicted changes, and gray while that's unknown. The branch takes two
# quick git calls, so precmd looks it up on every prompt. `git status` can
# take seconds in a large repo, so bin/git-prompt-dirty runs it in the
# background and zle repaints the prompt when it answers. Until then the
# prompt keeps the last answer for the same work tree, or gray for a new one.
typeset -gA __git_prompt_state   # work tree root -> dirty, clean, or "" when unknown
typeset -g __git_prompt_seg="" __git_prompt_branch="" __git_prompt_top=""
typeset -g __git_prompt_fd="" __git_prompt_fd_top="" __git_prompt_rerun=0

# Rebuilds the "[branch] " segment PS1 shows from the branch and known state.
__git_prompt_render() {
  local color="%F{8}"
  if [[ -z $__git_prompt_branch ]]; then
    __git_prompt_seg=""
    return
  fi

  # No work tree (inside .git, or a bare repo) can't report changes, so red.
  if [[ -z $__git_prompt_top ]]; then
    color="%F{red}"
  else
    case ${__git_prompt_state[$__git_prompt_top]} in
      dirty) color="%F{red}" ;;
      clean) color="%F{green}" ;;
    esac
  fi

  # Escape % so a branch name can't inject prompt sequences.
  __git_prompt_seg="[$color${__git_prompt_branch//\%/%%}%f] "
}

# Stops watching the running background check, if any.
__git_prompt_async_stop() {
  [[ -z $__git_prompt_fd ]] && return
  zle -F $__git_prompt_fd 2>/dev/null
  exec {__git_prompt_fd}<&-
  __git_prompt_fd=""
}

# Starts a background dirty check for work tree $1. If one is already running
# there, it reruns once finished instead, since the command just run may have
# changed files after it started.
__git_prompt_async_start() {
  local top=$1 helper="$HOME/.dotfiles/bin/git-prompt-dirty"
  if [[ -n $__git_prompt_fd && $__git_prompt_fd_top == $top ]]; then
    __git_prompt_rerun=1
    return
  fi
  __git_prompt_async_stop

  # Without zle nothing can repaint the prompt later, so check in line.
  if [[ ! -o zle ]]; then
    __git_prompt_state[$top]=$("$helper" "$top")
    return
  fi

  # zle calls __git_prompt_async_done once the helper answers or exits.
  exec {__git_prompt_fd}< <("$helper" "$top" 2>/dev/null)
  __git_prompt_fd_top=$top
  __git_prompt_rerun=0
  zle -F $__git_prompt_fd __git_prompt_async_done
}

# Records the background check's answer and repaints the prompt.
__git_prompt_async_done() {
  local result top=$__git_prompt_fd_top
  IFS= read -r result <&$1
  __git_prompt_async_stop
  __git_prompt_state[$top]=$result

  # Check again if a prompt asked while this one was running.
  if (( __git_prompt_rerun )) && [[ $top == $__git_prompt_top ]]; then
    __git_prompt_async_start $top
  fi
  __git_prompt_render
  zle reset-prompt
}

# Looks up the branch for this prompt and starts the dirty check.
__git_prompt_precmd() {
  local info branch rc
  __git_prompt_branch="" __git_prompt_top=""

  # rev-parse prints "true" and the root in a work tree, "false" inside .git
  # or a bare repo, and nothing outside a repository.
  info=$(git rev-parse --is-inside-work-tree --show-toplevel 2>/dev/null)
  case $info in
    true$'\n'*) __git_prompt_top=${info#true$'\n'} ;;
    false*) ;;
    *) __git_prompt_render; return 0 ;;
  esac

  # Exit status 0 means on a branch, 1 a detached HEAD.
  branch=$(git symbolic-ref --short -q HEAD 2>/dev/null)
  rc=$?
  if (( rc > 1 )); then
    __git_prompt_render
    return 0
  elif (( rc == 1 )); then
    branch=$(__git_branch_at_head)
    branch="${branch:-$(git rev-parse --short HEAD 2>/dev/null)} (detached)"
  fi
  __git_prompt_branch=$branch

  [[ -n $__git_prompt_top ]] && __git_prompt_async_start $__git_prompt_top
  __git_prompt_render
}

autoload -Uz add-zsh-hook
add-zsh-hook precmd __git_prompt_precmd

show_host_if_remote() {
  if [[ ! -z "$SSH_CONNECTION" ]]; then
    # PROMPT_HOST overrides the hostname; escape % so it can't inject prompt sequences
    local host="${PROMPT_HOST:-$(hostname)}"
    echo "%F{blue}${host//\%/%%}%f"
  fi
}

# Prompt escapes rather than whoami, which would fork twice per prompt: %n is
# the user name and %(!.a.b) picks a when running with root privileges.
show_colored_user() {
  echo '%(!.%F{red}%n%f.%n)'
}

show_path() {
  echo "%F{cyan}%~%f"
}

# Set the prompt
PS1='${__git_prompt_seg}$(show_colored_user)@$(show_host_if_remote)$(show_path): '