#compdef docker
# Zsh tab completion for docker, generated by docker itself
# Docker Desktop installs docker in ~/.docker/bin (see shared/env)

# The generated script redefines _docker; call it only if that worked
local stub="$functions[_docker]"
eval "$(docker completion zsh 2>/dev/null)"
[[ "$functions[_docker]" != "$stub" ]] && _docker "$@"
