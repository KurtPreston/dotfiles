# Zsh tab completion functions

# Completion function for 'c' alias
_c_completion() {
    local code_home="${CODE_HOME:-$HOME/Code}"

    # Complete directories (including nested paths) relative to CODE_HOME
    if [[ -d "$code_home" ]]; then
        _path_files -W "$code_home" -/
    fi
}

# Register completion for the 'c' alias (only if compdef is available)
if (( $+functions[compdef] )); then
    compdef _c_completion c
fi
