#!/usr/bin/env bash

# Git Branch Clean
# Cleans out local and remote branches merged into the remote default, then gc

set -euo pipefail

# Run local branch cleanup (fetches first, then deletes local merged branches)
echo "Cleaning local branches..."
git-branch-clean-local

# Run remote branch cleanup (fetches again, then deletes remote merged branches)
echo "Cleaning remote branches..."
git-branch-clean-remote

# Run git gc
echo "Running git gc..."
git gc
