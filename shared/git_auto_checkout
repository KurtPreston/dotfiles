# Git Auto-Checkout functionality
# This file is sourced by bash and zsh
# Automatically checks out matching branches when on detached HEAD

# Echoes the full refname of a remote-tracking branch whose tip is the current
# HEAD, preferring origin when several remotes match.
__git_auto_checkout_remote_ref() {
    local ref match
    match=""

    while IFS= read -r ref; do
        # refs/remotes/<remote>/HEAD points at the remote's default branch and
        # is not something that can be checked out.
        case "$ref" in
            ''|*/HEAD) continue ;;
        esac

        if [ -z "$match" ]; then
            match="$ref"
        fi

        case "$ref" in
            refs/remotes/origin/*) match="$ref"; break ;;
        esac
    done <<EOF
$(git for-each-ref --format='%(refname)' --points-at HEAD refs/remotes/ 2>/dev/null)
EOF

    [ -n "$match" ] || return 1
    printf '%s\n' "$match"
}

# Auto-checkout matching branch if on detached HEAD
git_auto_checkout() {
    local git_dir state branch short_sha remote_ref rest remote

    git_dir=$(git rev-parse --git-dir 2>/dev/null) || return 0

    # Already on a branch.
    git symbolic-ref -q HEAD >/dev/null 2>&1 && return 0

    # Rebase, bisect, merge, cherry-pick and revert all detach HEAD on purpose.
    # Checking out a branch mid-operation would abandon it.
    for state in rebase-merge rebase-apply BISECT_LOG MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
        if [ -e "$git_dir/$state" ]; then
            return 0
        fi
    done

    short_sha=$(git rev-parse --short HEAD 2>/dev/null)

    branch=$(git for-each-ref --count=1 --format='%(refname:short)' --points-at HEAD refs/heads/ 2>/dev/null)
    if [ -n "$branch" ]; then
        echo "Detached HEAD $short_sha matches branch '$branch'. Checking out..."
        git checkout "$branch" >/dev/null 2>&1
        return 0
    fi

    remote_ref=$(__git_auto_checkout_remote_ref) || return 0
    rest=${remote_ref#refs/remotes/}
    remote=${rest%%/*}
    branch=${rest#*/}

    # A local branch of the same name exists but sits on a different commit, so
    # checking it out would move away from where HEAD currently is.
    if git show-ref --verify --quiet "refs/heads/$branch"; then
        return 0
    fi

    echo "Detached HEAD $short_sha matches '$remote/$branch'. Creating tracking branch..."
    git checkout -b "$branch" --track "$remote/$branch" >/dev/null 2>&1

    return 0
}

# Set up auto-switching hooks based on shell type
if [ -n "$ZSH_VERSION" ]; then
    # Zsh hook
    autoload -U add-zsh-hook
    add-zsh-hook chpwd git_auto_checkout
elif [ -n "$BASH_VERSION" ]; then
    # Bash hook using PROMPT_COMMAND
    __git_auto_checkout_wrapper() {
        local exit_code=$?
        git_auto_checkout
        return $exit_code
    }

    if [[ ":$PROMPT_COMMAND:" != *":__git_auto_checkout_wrapper:"* ]]; then
        PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND; }__git_auto_checkout_wrapper"
    fi
fi

# Run once on shell startup for current directory
git_auto_checkout
